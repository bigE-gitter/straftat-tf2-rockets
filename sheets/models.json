{
  "sheet": "models",
  "about": "TF2 models the player can pick for their launcher viewmodel and their rockets. export_models.py reads each from the player's own TF2 (nothing is shipped). Launchers come from items_game.txt model_player (item_class tf_weapon_rocketlauncher*/particle_cannon); projectiles are TF2's hard-coded rocket/energy-ball w_models found in the VPKs.",
  "columns": {
    "id": "config value and file name",
    "name": "shown in the F8 panel",
    "kind": "launcher | projectile | sniper (TF2 rifle for slot 2) | straftat_sniper (a STRAFTAT gun shown from the game's own prefab) | weapon (other slot models) | sound (sound set only)",
    "mdl": "path inside TF2's VPKs",
    "item_def": "items_game item id (launchers)",
    "verified_offline": "exported and rendered offline",
    "verified_in_game": "seen in the running game",
    "extra": "more models drawn with it (TF2 festive lights are a separate model on top of the stock launcher)",
    "fire_sound": "TF2 soundscript entry for a shot (items_game visuals sound_single_shot; stock weapons: their weapon script's single_shot)",
    "explode_sound": "TF2 soundscript entry for the blast (items_game sound_special1 when it is an explosion, else TF2's BaseExplosionEffect.Sound)",
    "fire_waves": "the files behind fire_sound in TF2's VPKs (resolved from game_sounds_weapons.txt by the sheet tool; TF2 picks one at random)",
    "explode_waves": "the files behind explode_sound",
    "prefab": "straftat_sniper only: the STRAFTAT weapon prefab (Resources/RandomWeapons) whose meshes, materials and shot sound are shown"
  },
